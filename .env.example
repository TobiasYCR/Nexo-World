# Servidor de cuentas y puntuaciones (npm run server y npm run admin). Copiar como .env y completar.
API_HOST=127.0.0.1
API_PORT=3001
ALLOWED_ORIGIN=http://localhost:5173

# postgres (por defecto) o memory para probar sin base de datos
STORAGE=postgres

# PostgreSQL local. Con DATABASE_URL (la de Render) estas líneas no se usan.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=nexo_world

# Para conectarse desde tu PC a la base de Render, pegá su "External Database URL":
# DATABASE_URL=postgresql://usuario:clave@dpg-xxxx.oregon-postgres.render.com/nexo_world
